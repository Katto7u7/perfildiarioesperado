# Copiar a .env (no se sube a git) y completar.
# FUENTE: de dónde se LEEN las fuentes. sqlite = archivos .db de config.yaml (por defecto) | postgres
FUENTE=sqlite

# Solo con FUENTE=postgres (usuario con permiso de lectura)
PGHOST=
PGPORT=5432
PGDATABASE=sucursales
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
